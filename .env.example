# Sync frequency in minutes (default: 60)
SYNC_INTERVAL_MINUTES=60

# Only download binary files whose MIME type is in this comma-separated list.
# Google Workspace files (Docs, Sheets, Slides) are always exported regardless.
# Leave empty to download everything.
# Examples:
#   ALLOWED_MIME_TYPES=application/pdf
#   ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
ALLOWED_MIME_TYPES=

# Override data/download directories if needed (defaults shown)
# DATA_DIR=./data
# DOWNLOADS_DIR=./downloads
